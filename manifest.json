{
  "display_information": {
    "name": "Jarvis"
  },
  "features": {
    "agent_view": {
      "agent_description": "Jarvis — your friendly AI assistant in Slack. Ask me anything, and I'll help you out!",
      "suggested_prompts": []
    },
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "Jarvis",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/jarvis-help",
        "description": "Show the list of available commands",
        "usage_hint": "/jarvis-help",
        "should_escape": false
      },
      {
        "command": "/jarvis-ping",
        "description": "Check bot latency and uptime",
        "usage_hint": "/jarvis-ping",
        "should_escape": false
      },
      {
        "command": "/jarvis-catfact",
        "description": "Get a random cat fact",
        "usage_hint": "/jarvis-catfact",
        "should_escape": false
      },
      {
        "command": "/jarvis-joke",
        "description": "Get a random joke",
        "usage_hint": "/jarvis-joke",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "assistant:write",
        "channels:history",
        "chat:write",
        "commands",
        "groups:history",
        "im:history",
        "im:read",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_home_opened", "app_mention", "message.channels", "message.groups", "message.im"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true
  }
}
