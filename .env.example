# AI provider (Hack Club AI proxy)
# Get a key from https://ai.hackclub.com — required for AI chat (mentions and DMs).
# Without it the bot still runs, but only the slash commands work.
HACKCLUB_AI_API_KEY=YOUR_HACKCLUB_AI_API_KEY

# Optional. Overrides below are only needed if the proxy endpoint or model changes.
# HACKCLUB_AI_BASE_URL=https://ai.hackclub.com/proxy/v1
# HACKCLUB_AI_MODEL=openai/gpt-4o-mini

# Required, from your Slack app:
#   SLACK_BOT_TOKEN  -> OAuth & Permissions -> Bot User OAuth Token (starts with xoxb-)
#   SLACK_APP_TOKEN  -> Basic Information -> App-Level Tokens (starts with xapp-, scope connections:write)
SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN
SLACK_APP_TOKEN=YOUR_SLACK_APP_TOKEN

# Optional. Set to "production" to quiet debug logging.
# NODE_ENV=development
