# Required, set your Google AI Studio API key (free at https://aistudio.google.com).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional. Google's OpenAI-compatible endpoint is the default; override to use any provider.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional. Defaults to gemini-3.1-flash-lite (the cheapest model available to new accounts).
# GEMINI_MODEL=gemini-3.1-flash-lite

# Required, from your Slack app:
#   SLACK_BOT_TOKEN  -> OAuth & Permissions -> Bot User OAuth Token (starts with xoxb-)
#   SLACK_APP_TOKEN  -> Basic Information -> App-Level Tokens (starts with xapp-, scope connections:write)
SLACK_BOT_TOKEN=YOUR_SLACK_BOT_TOKEN
SLACK_APP_TOKEN=YOUR_SLACK_APP_TOKEN
